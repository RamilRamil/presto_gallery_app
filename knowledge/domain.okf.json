      "source": "outbox",
      "target": "preview-png"
    },
    {
      "@type": "Contains",
      "source": "outbox",
      "target": "presto-bin-format"
    },
    {
      "@type": "BelongsTo",
      "source": "rgb-color",
      "target": "layer",
      "properties": {
        "level": 1
      }
    },
    {
      "@type": "BelongsTo",
      "source": "size",
