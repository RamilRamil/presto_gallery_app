{
  "@context": "https://schema.org",
  "@type": "Knowledge",
  "name": "PRESTO_PIC_LOADER domain",
  "description": "Domain vocabulary for converting images into pixel art for the Pimoroni Presto. Code identifiers and spec terms must match these entities.",
  "entities": [
    {
      "@id": "source-image",
      "@type": "DataEntity",
      "name": "SourceImage",
      "description": "Input picture of any size (PNG, JPEG or WebP) read from the inbox; converted to RGB, alpha flattened onto the background color.",
      "properties": {
        "width": {
          "@type": "Integer",
          "value": "pixels"
        },
        "height": {
          "@type": "Integer",
          "value": "pixels"
        },
        "acceptedExtensions": {
          "@type": "Text",
          "value": ".png .jpg .jpeg .webp"
        }
      }
    },
    {
      "@id": "rgb-color",
      "@type": "DataEntity",
      "name": "RgbColor",
      "description": "A color as three 0..255 channels (red, green, blue).",
      "properties": {
        "red": {
          "@type": "Integer",
          "value": "0..255"
        },
        "green": {
          "@type": "Integer",
          "value": "0..255"
        },
        "blue": {
          "@type": "Integer",
          "value": "0..255"
        }
      }
    },
    {
      "@id": "size",
      "@type": "DataEntity",
      "name": "Size",
      "description": "Width and height in pixels or cells.",
      "properties": {
        "width": {
          "@type": "Integer",
          "value": ">= 1"
        },
        "height": {
          "@type": "Integer",
          "value": ">= 1"
        }
      }
    },
    {
      "@id": "grid",
      "@type": "DataEntity",
      "name": "Grid",
      "description": "Square cell grid that the image is reduced to; one cell becomes one pixel-art pixel.",
      "properties": {
        "gridSize": {
          "@type": "Integer",
          "value": "16 | 32 | 40 | 60 | 64 | 80 | 120 | 240 | 480",
          "qualifiers": {
            "default": 32
          }
        },
        "cellSize": {
          "@type": "Integer",
          "value": "floor(screenSize / gridSize): 30, 15, 12, 8, 7, 6, 4, 2 or 1 px"
        }
      }
    },
    {
      "@id": "presto-screen",
      "@type": "DeviceEntity",
      "name": "PrestoScreen",
      "description": "Pimoroni Presto display in full-resolution mode: every one of the 480x480 panel pixels is drawn.",
      "properties": {
        "screenSize": {
          "@type": "Integer",
          "value": 480
        }
      }
    },
    {
      "@id": "palette",
      "@type": "DataEntity",
      "name": "Palette",
      "description": "Ordered list of RgbColor (1..256 entries); pixel-art pixels store indices into it. Either adaptive (built from the image) or a named preset.",
      "properties": {
        "colorCount": {
          "@type": "Integer",
          "value": "2..256",
          "qualifiers": {
            "default": 16
          }
        },
        "paletteName": {
          "@type": "Text",
          "value": "adaptive | pico-8"
        }
      }
    },
    {
      "@id": "pico-8-palette",
      "@type": "PresetEntity",
      "name": "Pico8Palette",
      "description": "Fixed 16-color PICO-8 preset palette.",
      "properties": {
        "colorCount": {
          "@type": "Integer",
          "value": 16
        }
      }
    },
    {
      "@id": "fit-mode",
      "@type": "EnumEntity",
      "name": "FitMode",
      "description": "How a non-square SourceImage is mapped to the square Grid: crop (center crop to square) or fit (scale to fit, pad with background color).",
      "properties": {
        "values": {
          "@type": "Text",
          "value": "crop | fit",
          "qualifiers": {
            "default": "crop"
          }
        }
      }
    },
    {
      "@id": "dithering",
      "@type": "SettingEntity",
      "name": "Dithering",
      "description": "Floyd-Steinberg error diffusion while mapping colors to the Palette; on or off.",
      "properties": {
        "dither": {
          "@type": "Boolean",
          "value": "true | false",
          "qualifiers": {
            "default": false
          }
        }
      }
    },
    {
      "@id": "pixelize-settings",
      "@type": "DataEntity",
      "name": "PixelizeSettings",
      "description": "Immutable set of conversion options passed to the pixelize pipeline.",
      "properties": {
        "gridSize": {
          "@type": "Integer",
          "value": "16 | 32 | 40 | 60 | 64 | 80 | 120 | 240 | 480"
        },
        "colorCount": {
          "@type": "Integer",
          "value": "2..256"
        },
        "paletteName": {
          "@type": "Text",
          "value": "adaptive | pico-8"
        },
        "fitMode": {
          "@type": "Text",
          "value": "crop | fit"
        },
        "dither": {
          "@type": "Boolean",
          "value": "true | false"
        },
        "backgroundColor": {
          "@type": "Text",
          "value": "RgbColor, default black"
        }
      }
    },
    {
      "@id": "frame",
      "@type": "DataEntity",
      "name": "Frame",
      "description": "One image of PixelArt: gridSize x gridSize palette indices in row-major order plus a display duration. MVP produces exactly one frame.",
      "properties": {
        "indices": {
          "@type": "Bytes",
          "value": "width*height bytes, row-major"
        },
        "durationMs": {
          "@type": "Integer",
          "value": "0..65535, 0 = static"
        }
      }
    },
    {
      "@id": "pixel-art",
      "@type": "DataEntity",
      "name": "PixelArt",
      "description": "Format-independent result of pixelize: size, Palette and a list of Frame.",
      "properties": {
        "width": {
          "@type": "Integer",
          "value": "= gridSize"
        },
        "height": {
          "@type": "Integer",
          "value": "= gridSize"
        },
        "frameCount": {
          "@type": "Integer",
          "value": ">= 1"
        }
      }
    },
    {
      "@id": "pixelize-pipeline",
      "@type": "ProcessEntity",
      "name": "PixelizePipeline",
      "description": "Pure calculation pixelize(image, settings) -> PixelArt: fit to square, downscale to Grid, build/choose Palette, map colors (optionally dithered).",
      "properties": {}
    },
    {
      "@id": "preview-png",
      "@type": "OutputEntity",
      "name": "PreviewPng",
      "description": "PNG for human viewing: each cell drawn as a large square block.",
      "properties": {
        "previewScale": {
          "@type": "Integer",
          "value": "pixels per cell",
          "qualifiers": {
            "default": 8
          }
        }
      }
    },
    {
      "@id": "presto-bin-format",
      "@type": "OutputEntity",
      "name": "PrestoBinFormat",
      "description": "Versioned little-endian binary file for the Presto player: header, palette, frames. Documented in docs/bin-format.md.",
      "properties": {
        "magic": {
          "@type": "Text",
          "value": "PPXA"
        },
        "formatVersion": {
          "@type": "Integer",
          "value": 1
        },
        "fileExtension": {
          "@type": "Text",
          "value": ".bin"
        }
      }
    },
    {
      "@id": "encoder",
      "@type": "ProcessEntity",
      "name": "Encoder",
      "description": "Pure function PixelArt -> bytes for one output format; the format abstraction barrier.",
      "properties": {}
    },
    {
      "@id": "inbox",
      "@type": "LocationEntity",
      "name": "Inbox",
      "description": "Folder inbox/ where the user drops SourceImage files.",
      "properties": {
        "path": {
          "@type": "Text",
          "value": "inbox/"
        }
      }
    },
    {
      "@id": "outbox",
      "@type": "LocationEntity",
      "name": "Outbox",
      "description": "Folder outbox/ receiving <name>.preview.png and <name>.bin for each processed SourceImage.",
      "properties": {
        "path": {
          "@type": "Text",
          "value": "outbox/"
        }
      }
    },
    {
      "@id": "cli",
      "@type": "ProcessEntity",
      "name": "Cli",
      "description": "Single command that processes every SourceImage in the Inbox with the given PixelizeSettings.",
      "properties": {
        "command": {
          "@type": "Text",
          "value": "python -m presto_pic_loader [options]"
        }
      }
    },
    {
      "@id": "layer",
      "@type": "ArchitectureEntity",
      "name": "Layer",
      "description": "Stratified-design level; code in a layer calls only its own or lower layers. 1 primitives, 2 image operations, 3 pipeline, 4 encoders, 5 actions.",
      "properties": {
        "level": {
          "@type": "Integer",
          "value": "1..5"
        },
        "isPure": {
          "@type": "Boolean",
          "value": "true for 1..4, false for 5"
        }
      }
    },
    {
      "@id": "media-item",
      "@type": "DataEntity",
      "name": "MediaItem",
      "description": "One stored item on the device plus its metadata: a picture (PrestoBinFormat file) or a Scene.",
      "properties": {
        "mediaId": {
          "@type": "Text",
          "value": "8 hex chars"
        },
        "name": {
          "@type": "Text",
          "value": "1..64 chars"
        },
        "tags": {
          "@type": "List",
          "value": "Tag names"
        },
        "frameCount": {
          "@type": "Integer",
          "value": ">= 1 for a picture, 0 for a Scene"
        },
        "gridSize": {
          "@type": "Integer",
          "value": "16 | 32 | 40 | 60 | 64 | 80 | 120 | 240 | 480, 0 for a Scene"
        },
        "byteSize": {
          "@type": "Integer",
          "value": "bytes"
        },
        "createdAt": {
          "@type": "Integer",
          "value": "unix seconds"
        },
        "kind": {
          "@type": "Text",
          "value": "picture | scene"
        },
        "flagged": {
          "@type": "Boolean",
          "value": "true for a Scene left out of the Playlist"
        },
        "error": {
          "@type": "Text",
          "value": "last Scene error or null"
        }
      }
    },
    {
      "@id": "tag",
      "@type": "DataEntity",
      "name": "Tag",
      "description": "Normalized label (trimmed, lowercased, 1..24 chars) attached to MediaItems.",
      "properties": {
        "label": {
          "@type": "Text",
          "value": "1..24 chars"
        }
      }
    },
    {
      "@id": "catalog",
      "@type": "DataEntity",
      "name": "Catalog",
      "description": "All MediaItems and Collections on the device; persisted atomically as catalog.json.",
      "properties": {
        "formatVersion": {
          "@type": "Integer",
          "value": 1
        }
      }
    },
    {
      "@id": "show-mode",
      "@type": "EnumEntity",
      "name": "ShowMode",
      "description": "Which MediaItems are shown: all, images (one frame), animations (many frames), scenes, collection (one Collection), tags (any of selected). In scenes the slideSeconds of DeviceSettings does not apply: a Scene plays until a swipe or a change.",
      "properties": {
        "values": {
          "@type": "Text",
          "value": "all | images | animations | scenes | collection | tags",
          "qualifiers": {
            "default": "all"
          }
        }
      }
    },
    {
      "@id": "device-settings",
      "@type": "DataEntity",
      "name": "DeviceSettings",
      "description": "Persisted playback settings on the device. Its slideSeconds and shuffle are the general values; a Collection shown by ShowMode 'collection' may override them with CollectionShowSettings.",
      "properties": {
        "showMode": {
          "@type": "Text",
          "value": "ShowMode"
        },
        "selectedTags": {
          "@type": "List",
          "value": "Tag names"
        },
        "slideSeconds": {
          "@type": "Integer",
          "value": "3..600",
          "qualifiers": {
            "default": 10
          }
        },
        "shuffle": {
          "@type": "Boolean",
          "value": "true | false",
          "qualifiers": {
            "default": false
          }
        },
        "selectedCollection": {
          "@type": "Text",
          "value": "collectionId or null"
        },
        "brightness": {
          "@type": "Integer",
          "value": "Brightness in percent"
        },
        "ambientLeds": {
          "@type": "Boolean",
          "value": "true | false",
          "qualifiers": {
            "default": true
          }
        }
      }
    },
    {
      "@id": "playlist",
      "@type": "DataEntity",
      "name": "Playlist",
      "description": "Ordered list of mediaId derived from Catalog and DeviceSettings.",
      "properties": {
        "mediaIds": {
          "@type": "List",
          "value": "mediaId"
        }
      }
    },
    {
      "@id": "media-storage",
      "@type": "LocationEntity",
      "name": "MediaStorage",
      "description": "Device storage root: microSD if mounted, otherwise internal flash.",
      "properties": {
        "path": {
          "@type": "Text",
          "value": "/sd/gallery or /gallery"
        }
      }
    },
    {
      "@id": "device-app",
      "@type": "ProcessEntity",
      "name": "DeviceApp",
      "description": "MicroPython application on the Presto: Wi-Fi, HttpApi, storage, playback, touch.",
      "properties": {}
    },
    {
      "@id": "http-api",
      "@type": "InterfaceEntity",
      "name": "HttpApi",
      "description": "JSON/binary HTTP interface served by the DeviceApp for the WebUi.",
      "properties": {
        "basePath": {
          "@type": "Text",
          "value": "/api"
        }
      }
    },
    {
      "@id": "web-ui",
      "@type": "ProcessEntity",
      "name": "WebUi",
      "description": "Browser application served by the DeviceApp: converts images/GIFs into PixelArt, manages the Catalog and DeviceSettings.",
      "properties": {}
    },
    {
      "@id": "golden-vector",
      "@type": "DataEntity",
      "name": "GoldenVector",
      "description": "Test case shared by all producers: grid-sized RGB pixels + PixelizeSettings -> expected .bin bytes.",
      "properties": {
        "fileName": {
          "@type": "Text",
          "value": "tests/golden/*.json"
        }
      }
    },
    {
      "@id": "scene",
      "@type": "DataEntity",
      "name": "Scene",
      "description": "Stored MicroPython script drawing an animation in code through run(stop) and the pixel helpers; a MediaItem kind. Trusted code with no sandbox.",
      "properties": {
        "entryPoint": {
          "@type": "Text",
          "value": "run(stop)"
        },
        "maxBytes": {
          "@type": "Integer",
          "value": 262144
        }
      }
    },
    {
      "@id": "scene-speed",
      "@type": "SettingEntity",
      "name": "SceneSpeed",
      "description": "How fast a Scene plays relative to its own pauses, stored per Scene in whole percent. Pauses are divided by it; the Scene file does not change.",
      "properties": {
        "settingName": {
          "@type": "Text",
          "value": "speedPercent"
        },
        "allowedValues": {
          "@type": "Text",
          "value": "25, 50, 100, 200, 400"
        },
        "defaultValue": {
          "@type": "Integer",
          "value": 100
        }
      }
    },
    {
      "@id": "access-password",
      "@type": "SettingEntity",
      "name": "AccessPassword",
      "description": "Single secret from the device secrets file that grants access to the HttpApi; required for Scene upload.",
      "properties": {
        "settingName": {
          "@type": "Text",
          "value": "WEB_PASSWORD"
        }
      }
    },
    {
      "@id": "crop-view",
      "@type": "DataEntity",
      "name": "CropView",
      "description": "The chosen square part of a picture in the WebUi: its center in source pixels and its zoom. Not stored on the device.",
      "properties": {
        "centerX": {
          "@type": "Number",
          "value": "source pixels"
        },
        "centerY": {
          "@type": "Number",
          "value": "source pixels"
        },
        "zoom": {
          "@type": "Number",
          "value": "1..8"
        }
      }
    },
    {
      "@id": "collection",
      "@type": "DataEntity",
      "name": "Collection",
      "description": "Named, ordered set of MediaItems put together by hand; items can have different Tags and belong to several Collections. It may have its own CollectionShowSettings. It stores no SceneSpeed of its own but can set the SceneSpeed of all the Scenes it has at that moment.",
      "properties": {
        "collectionId": {
          "@type": "Text",
          "value": "8 hex chars"
        },
        "name": {
          "@type": "Text",
          "value": "1..64 chars, unique"
        },
        "mediaIds": {
          "@type": "List",
          "value": "mediaId in the order added"
        },
        "slideSeconds": {
          "@type": "Integer",
          "value": "3..600, optional: CollectionShowSettings"
        },
        "shuffle": {
          "@type": "Boolean",
          "value": "optional: CollectionShowSettings"
        }
      }
    },
    {
      "@id": "collection-show-settings",
      "@type": "SettingEntity",
      "name": "CollectionShowSettings",
      "description": "Optional own slide time and order of one Collection, stored in the Collection. They apply only while ShowMode is 'collection' with that Collection; a missing value means the general DeviceSettings value.",
      "properties": {
        "settingName": {
          "@type": "Text",
          "value": "slideSeconds, shuffle"
        },
        "allowedValues": {
          "@type": "Text",
          "value": "slideSeconds 3..600 or absent; shuffle true | false or absent"
        },
        "defaultValue": {
          "@type": "Text",
          "value": "absent (as in DeviceSettings)"
        }
      }
    },
    {
      "@id": "upload-queue",
      "@type": "DataEntity",
      "name": "UploadQueue",
      "description": "Files waiting for upload in the WebUi. Each follows the setup of the reference file, value by value, unless the user set that value on the file. Not stored on the device.",
      "properties": {
        "state": {
          "@type": "Text",
          "value": "waiting | uploading | done | failed"
        },
        "referenceFile": {
          "@type": "Text",
          "value": "the first picture or GIF in the queue; what is set on it applies to the other files"
        },
        "setup": {
          "@type": "Text",
          "value": "conversion settings, relative CropView, Tags and target Collection of one file"
        }
      }
    },
    {
      "@id": "device-menu",
      "@type": "ProcessEntity",
      "name": "DeviceMenu",
      "description": "Touch menu on the Presto, opened by a long press, for choosing what to show and for managing the current item, Collections (including their CollectionShowSettings) and Tags. Its 'Настройки' screen switches AmbientLeds.",
      "properties": {}
    },
    {
      "@id": "gesture",
      "@type": "ProcessEntity",
      "name": "Gesture",
      "description": "One finger movement on the Presto, classified as a tap, a long press or a swipe in one of four directions.",
      "properties": {}
    },
    {
      "@id": "brightness",
      "@type": "DataEntity",
      "name": "Brightness",
      "description": "Screen level on the device in percent, one of 10, 25, 50, 75, 100; part of DeviceSettings.",
      "properties": {}
    },
    {
      "@id": "ambient-leds",
      "@type": "DataEntity",
      "name": "AmbientLeds",
      "description": "The 7 RGB LEDs on the back of the Presto. While DeviceSettings.ambientLeds is true, the firmware gives each LED the colour of the screen edge next to it on every screen update (pictures, GIFs, Scenes, the menu); when false, all LEDs are dark. One general setting; not changed by Collections; independent of Brightness.",
      "properties": {
        "ledCount": {
          "@type": "Integer",
          "value": "7"
        }
      }
    },
    {
      "@id": "pause",
      "@type": "ProcessEntity",
      "name": "Pause",
      "description": "Temporary state in which the slideshow stays on the current item; animations keep playing; never stored.",
      "properties": {}
    },
    {
      "@id": "on-screen-keyboard",
      "@type": "ProcessEntity",
      "name": "OnScreenKeyboard",
      "description": "Pages of keys for entering a Collection or Tag name on the Presto.",
      "properties": {}
    }
  ],
  "relations": [
