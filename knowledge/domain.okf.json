      "source": "pixelize-settings",
      "target": "dithering"
    },
    {
      "@type": "Selects",
      "source": "pixelize-settings",
      "target": "palette"
    },
    {
      "@type": "DerivedFrom",
      "source": "grid",
      "target": "presto-screen",
      "properties": {
        "rule": "cellSize = floor(screenSize / gridSize)"
      }
    },
    {
      "@type": "Consumes",
      "source": "pixelize-pipeline",
      "target": "source-image"
    },
    {
