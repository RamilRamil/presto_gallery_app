{
  "@context": "https://schema.org",
  "@type": "Knowledge",
  "name": "PRESTO_PIC_LOADER domain",
  "description": "Domain vocabulary for converting images into pixel art for the Pimoroni Presto. Code identifiers and spec terms must match these entities.",
  "entities": [
    {
      "@id": "source-image",
      "@type": "DataEntity",
      "name": "SourceImage",
      "description": "Input picture of any size (PNG, JPEG or WebP) read from the inbox; converted to RGB, alpha flattened onto the background color.",
      "properties": {
        "width": {
          "@type": "Integer",
          "value": "pixels"
        },
        "height": {
          "@type": "Integer",
          "value": "pixels"
        },
        "acceptedExtensions": {
          "@type": "Text",
          "value": ".png .jpg .jpeg .webp"
        }
      }
    },
    {
      "@id": "rgb-color",
      "@type": "DataEntity",
      "name": "RgbColor",
      "description": "A color as three 0..255 channels (red, green, blue).",
      "properties": {
        "red": {
          "@type": "Integer",
          "value": "0..255"
        },
        "green": {
          "@type": "Integer",
          "value": "0..255"
        },
        "blue": {
          "@type": "Integer",
          "value": "0..255"
        }
      }
    },
    {
      "@id": "size",
      "@type": "DataEntity",
      "name": "Size",
      "description": "Width and height in pixels or cells.",
      "properties": {
        "width": {
          "@type": "Integer",
          "value": ">= 1"
        },
        "height": {
          "@type": "Integer",
          "value": ">= 1"
        }
      }
    },
    {
      "@id": "grid",
      "@type": "DataEntity",
      "name": "Grid",
      "description": "Square cell grid that the image is reduced to; one cell becomes one pixel-art pixel.",
      "properties": {
        "gridSize": {
          "@type": "Integer",
          "value": "16 | 32 | 64",
          "qualifiers": {
            "default": 32
          }
        },
        "cellSize": {
          "@type": "Integer",
          "value": "floor(screenSize / gridSize): 15, 7 or 3 px"
        }
      }
    },
    {
      "@id": "presto-screen",
      "@type": "DeviceEntity",
      "name": "PrestoScreen",
      "description": "Pimoroni Presto display in normal mode.",
      "properties": {
        "screenSize": {
          "@type": "Integer",
          "value": 240
        }
      }
    },
    {
      "@id": "palette",
      "@type": "DataEntity",
      "name": "Palette",
      "description": "Ordered list of RgbColor (1..256 entries); pixel-art pixels store indices into it. Either adaptive (built from the image) or a named preset.",
      "properties": {
        "colorCount": {
          "@type": "Integer",
          "value": "2..256",
          "qualifiers": {
            "default": 16
          }
        },
        "paletteName": {
          "@type": "Text",
          "value": "adaptive | pico-8"
        }
      }
    },
    {
      "@id": "pico-8-palette",
      "@type": "PresetEntity",
      "name": "Pico8Palette",
      "description": "Fixed 16-color PICO-8 preset palette.",
      "properties": {
        "colorCount": {
          "@type": "Integer",
          "value": 16
        }
      }
    },
    {
      "@id": "fit-mode",
      "@type": "EnumEntity",
      "name": "FitMode",
      "description": "How a non-square SourceImage is mapped to the square Grid: crop (center crop to square) or fit (scale to fit, pad with background color).",
      "properties": {
        "values": {
          "@type": "Text",
          "value": "crop | fit",
          "qualifiers": {
            "default": "crop"
          }
        }
      }
    },
    {
      "@id": "dithering",
      "@type": "SettingEntity",
      "name": "Dithering",
      "description": "Floyd-Steinberg error diffusion while mapping colors to the Palette; on or off.",
      "properties": {
        "dither": {
          "@type": "Boolean",
          "value": "true | false",
          "qualifiers": {
            "default": false
          }
        }
      }
    },
    {
      "@id": "pixelize-settings",
      "@type": "DataEntity",
      "name": "PixelizeSettings",
      "description": "Immutable set of conversion options passed to the pixelize pipeline.",
      "properties": {
        "gridSize": {
          "@type": "Integer",
          "value": "16 | 32 | 64"
        },
        "colorCount": {
          "@type": "Integer",
          "value": "2..256"
        },
        "paletteName": {
          "@type": "Text",
          "value": "adaptive | pico-8"
        },
        "fitMode": {
          "@type": "Text",
          "value": "crop | fit"
        },
        "dither": {
          "@type": "Boolean",
          "value": "true | false"
        },
        "backgroundColor": {
          "@type": "Text",
          "value": "RgbColor, default black"
        }
      }
    },
    {
      "@id": "frame",
      "@type": "DataEntity",
      "name": "Frame",
      "description": "One image of PixelArt: gridSize x gridSize palette indices in row-major order plus a display duration. MVP produces exactly one frame.",
      "properties": {
        "indices": {
          "@type": "Bytes",
          "value": "width*height bytes, row-major"
        },
        "durationMs": {
          "@type": "Integer",
          "value": "0..65535, 0 = static"
        }
      }
    },
    {
      "@id": "pixel-art",
      "@type": "DataEntity",
      "name": "PixelArt",
      "description": "Format-independent result of pixelize: size, Palette and a list of Frame.",
      "properties": {
        "width": {
          "@type": "Integer",
          "value": "= gridSize"
        },
        "height": {
          "@type": "Integer",
          "value": "= gridSize"
        },
        "frameCount": {
          "@type": "Integer",
          "value": ">= 1"
        }
      }
    },
    {
      "@id": "pixelize-pipeline",
      "@type": "ProcessEntity",
      "name": "PixelizePipeline",
      "description": "Pure calculation pixelize(image, settings) -> PixelArt: fit to square, downscale to Grid, build/choose Palette, map colors (optionally dithered).",
      "properties": {}
    },
    {
      "@id": "preview-png",
      "@type": "OutputEntity",
      "name": "PreviewPng",
      "description": "PNG for human viewing: each cell drawn as a large square block.",
      "properties": {
        "previewScale": {
          "@type": "Integer",
          "value": "pixels per cell",
          "qualifiers": {
            "default": 8
          }
        }
      }
    },
    {
      "@id": "presto-bin-format",
      "@type": "OutputEntity",
      "name": "PrestoBinFormat",
      "description": "Versioned little-endian binary file for the Presto player: header, palette, frames. Documented in docs/bin-format.md.",
      "properties": {
        "magic": {
          "@type": "Text",
          "value": "PPXA"
        },
        "formatVersion": {
          "@type": "Integer",
          "value": 1
        },
        "fileExtension": {
          "@type": "Text",
          "value": ".bin"
        }
      }
    },
    {
      "@id": "encoder",
      "@type": "ProcessEntity",
      "name": "Encoder",
      "description": "Pure function PixelArt -> bytes for one output format; the format abstraction barrier.",
      "properties": {}
    },
    {
      "@id": "inbox",
      "@type": "LocationEntity",
      "name": "Inbox",
      "description": "Folder inbox/ where the user drops SourceImage files.",
      "properties": {
        "path": {
          "@type": "Text",
          "value": "inbox/"
        }
      }
    },
    {
      "@id": "outbox",
      "@type": "LocationEntity",
      "name": "Outbox",
      "description": "Folder outbox/ receiving <name>.preview.png and <name>.bin for each processed SourceImage.",
      "properties": {
        "path": {
          "@type": "Text",
          "value": "outbox/"
        }
      }
    },
    {
      "@id": "cli",
      "@type": "ProcessEntity",
      "name": "Cli",
      "description": "Single command that processes every SourceImage in the Inbox with the given PixelizeSettings.",
      "properties": {
        "command": {
          "@type": "Text",
          "value": "python -m presto_pic_loader [options]"
        }
      }
    },
    {
      "@id": "layer",
      "@type": "ArchitectureEntity",
      "name": "Layer",
      "description": "Stratified-design level; code in a layer calls only its own or lower layers. 1 primitives, 2 image operations, 3 pipeline, 4 encoders, 5 actions.",
      "properties": {
        "level": {
          "@type": "Integer",
          "value": "1..5"
        },
        "isPure": {
          "@type": "Boolean",
          "value": "true for 1..4, false for 5"
        }
      }
    },
    {
      "@id": "media-item",
      "@type": "DataEntity",
      "name": "MediaItem",
      "description": "One stored PrestoBinFormat file on the device plus its metadata.",
      "properties": {
        "mediaId": {
          "@type": "Text",
          "value": "8 hex chars"
        },
        "name": {
          "@type": "Text",
          "value": "1..64 chars"
        },
        "tags": {
          "@type": "List",
          "value": "Tag names"
        },
        "frameCount": {
          "@type": "Integer",
          "value": ">= 1"
        },
        "gridSize": {
          "@type": "Integer",
          "value": "16 | 32 | 64"
        },
        "byteSize": {
          "@type": "Integer",
          "value": "bytes"
        },
        "createdAt": {
          "@type": "Integer",
          "value": "unix seconds"
        }
      }
    },
    {
      "@id": "tag",
      "@type": "DataEntity",
      "name": "Tag",
      "description": "Normalized label (trimmed, lowercased, 1..24 chars) attached to MediaItems.",
      "properties": {
        "label": {
          "@type": "Text",
          "value": "1..24 chars"
        }
      }
    },
    {
      "@id": "catalog",
      "@type": "DataEntity",
      "name": "Catalog",
      "description": "All MediaItems on the device; persisted atomically as catalog.json.",
      "properties": {
        "formatVersion": {
          "@type": "Integer",
          "value": 1
        }
      }
    },
    {
      "@id": "show-mode",
      "@type": "EnumEntity",
      "name": "ShowMode",
      "description": "Which MediaItems are shown: all, images (one frame), animations (many frames), tags (any of selected).",
      "properties": {
        "values": {
          "@type": "Text",
          "value": "all | images | animations | tags",
          "qualifiers": {
            "default": "all"
          }
        }
      }
    },
    {
      "@id": "device-settings",
      "@type": "DataEntity",
      "name": "DeviceSettings",
      "description": "Persisted playback settings on the device.",
      "properties": {
        "showMode": {
          "@type": "Text",
          "value": "ShowMode"
        },
        "selectedTags": {
          "@type": "List",
          "value": "Tag names"
        },
        "slideSeconds": {
          "@type": "Integer",
          "value": "3..600",
          "qualifiers": {
            "default": 10
          }
        },
        "shuffle": {
          "@type": "Boolean",
          "value": "true | false",
          "qualifiers": {
            "default": false
          }
        }
      }
    },
    {
      "@id": "playlist",
      "@type": "DataEntity",
      "name": "Playlist",
      "description": "Ordered list of mediaId derived from Catalog and DeviceSettings.",
      "properties": {
        "mediaIds": {
          "@type": "List",
          "value": "mediaId"
        }
      }
    },
    {
      "@id": "media-storage",
      "@type": "LocationEntity",
      "name": "MediaStorage",
      "description": "Device storage root: microSD if mounted, otherwise internal flash.",
      "properties": {
        "path": {
          "@type": "Text",
          "value": "/sd/gallery or /gallery"
        }
      }
    },
    {
      "@id": "device-app",
      "@type": "ProcessEntity",
      "name": "DeviceApp",
      "description": "MicroPython application on the Presto: Wi-Fi, HttpApi, storage, playback, touch.",
      "properties": {}
    },
    {
      "@id": "http-api",
      "@type": "InterfaceEntity",
      "name": "HttpApi",
      "description": "JSON/binary HTTP interface served by the DeviceApp for the WebUi.",
      "properties": {
        "basePath": {
          "@type": "Text",
          "value": "/api"
        }
      }
    },
    {
      "@id": "web-ui",
      "@type": "ProcessEntity",
      "name": "WebUi",
      "description": "Browser application served by the DeviceApp: converts images/GIFs into PixelArt, manages the Catalog and DeviceSettings.",
      "properties": {}
    },
    {
      "@id": "golden-vector",
      "@type": "DataEntity",
      "name": "GoldenVector",
      "description": "Test case shared by all producers: grid-sized RGB pixels + PixelizeSettings -> expected .bin bytes.",
      "properties": {
        "fileName": {
          "@type": "Text",
          "value": "tests/golden/*.json"
        }
      }
    }
  ],
  "relations": [
    {
